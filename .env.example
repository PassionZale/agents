OPENAI_API_KEY=
OPENAI_BASE_URL=

# Absolute path to the merged graphify graph (graphs/merged.json).
# Required for graphify-agent. Mastra dev runs the app with cwd=src/mastra/public,
# and graphify-mcp inherits that cwd, so a relative path won't resolve.
# Example: /Users/you/projects/agents/graphs/merged.json
GRAPHIFY_GRAPH_PATH=
